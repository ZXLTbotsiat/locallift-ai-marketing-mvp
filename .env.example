# Server-only secrets. Never expose these values to browser code or commit a real .env file.
# Optional GroqCloud provider. Availability and free-tier limits depend on the account and region.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_SEARCH_MODEL=openai/gpt-oss-20b
# Optional local-only bridge when Node must inherit a VPN or system proxy.
GROQ_PROXY_URL=
SEARCH_PROXY_URL=
PAGE_PROXY_URL=

# Optional Alibaba Cloud Model Studio OpenAI-compatible endpoint. When set, this is preferred over Groq for analysis.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3.8-flash
